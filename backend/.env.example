# Backend environment variables
# Copy to backend/.env for local development.
# NEVER commit .env — it is gitignored.
# Set these as Environment Variables in the Render dashboard.

# ── Core Django ────────────────────────────────────────────────────────────
# Generate a long random string: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-with-a-long-random-secret-key

# Set False in production
DEBUG=False

# ── Hosts / CORS / CSRF ────────────────────────────────────────────────────
# RENDER_EXTERNAL_HOSTNAME is injected automatically by Render.
# The known hostname is also hardcoded in settings.py as a safety net.
# You can still set this explicitly after your first deploy.
ALLOWED_HOSTS=ai-enabled-employment-matching-platform-1.onrender.com

# Your Vercel frontend URL — MUST include https:// and NO trailing slash
CORS_ALLOWED_ORIGINS=https://ai-employment-matching.vercel.app
CSRF_TRUSTED_ORIGINS=https://ai-employment-matching.vercel.app

# ── Database ───────────────────────────────────────────────────────────────
# Render PostgreSQL Internal Connection URL (from Render dashboard → your DB → Connect)
# Format: postgresql://user:password@host:port/dbname
# Without this, app falls back to SQLite (ephemeral — data lost on redeploy!)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Celery / Redis (optional) ──────────────────────────────────────────────
# Without this, Celery tasks run synchronously (CELERY_TASK_ALWAYS_EAGER=True).
# Resume upload and matching still work without Redis.
# REDIS_URL=redis://localhost:6379/0

# ── AI / SBERT ─────────────────────────────────────────────────────────────
# False = use TF-IDF + BM25 only (safe for Render free 512 MB tier)
# True  = also load sentence-transformers / torch (~300 MB RAM, needs Starter+)
SBERT_ENABLED=False
