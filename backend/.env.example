# Backend environment variables (Render)
# Copy to backend/.env for local development — NEVER commit .env itself

# ── Core Django ────────────────────────────────────────────────────
SECRET_KEY=replace-with-a-long-random-50-char-secret-key
DEBUG=False

# ── Hosts / CORS / CSRF ────────────────────────────────────────────
# RENDER_EXTERNAL_HOSTNAME is injected automatically by Render (no need to set manually).
# Set ALLOWED_HOSTS after first deploy once you know your Render URL.
ALLOWED_HOSTS=your-app.onrender.com
CORS_ALLOWED_ORIGINS=https://ai-employment-matching.vercel.app
CSRF_TRUSTED_ORIGINS=https://ai-employment-matching.vercel.app

# ── Database ────────────────────────────────────────────────────────
# Provided automatically by Render when you link a PostgreSQL database.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Celery / Redis (optional) ───────────────────────────────────────
# Only needed if you enable Celery background tasks.
REDIS_URL=redis://localhost:6379/0

# ── AI / SBERT (optional) ──────────────────────────────────────────
# Set to False on Render free tier (512 MB RAM) to skip loading the
# ~300 MB torch + Sentence-Transformer model.  TF-IDF + BM25 scoring
# still runs and produces meaningful match percentages.
# On Render Starter (2 GB RAM) you can leave this True.
SBERT_ENABLED=True
